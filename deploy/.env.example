# Orca 自托管部署环境变量模板。
#
# 正式使用无需手工复制本文件：直接运行 ./init.sh（自动生成 .env 并填好随机密钥）。
# 本文件仅作字段说明；手工方式：cp .env.example .env 后按注释填写。
#
# 对外入口：宿主机 Nginx 终结 TLS → 转发到 ORCA_AUTH_PORT（默认 8080）。
# 反代要点（WebSocket / X-Forwarded-For）见 deploy/nginx.example.conf。

# ---- 必填 ----
# 客户端访问的完整 origin：https、不带路径/尾斜杠，且与 Nginx 上的访问域名一致
# （桌面端会做 canonical origin 校验，且它逐字节用作 token issuer）
ORCA_RELAY_PUBLIC_URL=https://relay.example.com
# relay 的 assignment 签名密钥（≥32 字节 hex，compose 注入 relay 容器）
# 生成：openssl rand -hex 32（init.sh 会自动生成）
ORCA_RELAY_ASSIGNMENT_SIGNING_KEY=

# ---- 端口 ----
# 对外端口：宿主机 Nginx 转发到本端口（容器内固定 8080；默认即可，冲突时改这里）
ORCA_AUTH_PORT=8080

# ---- 数据目录 ----
# 两个 SQLite 库（auth.sqlite / orca-relay.sqlite）与 auth 签名密钥都落在该目录，
# 可直接查看；备份 = 打包复制该目录：
#   tar czf orca-data-$(date +%F).tgz data/
# 相对路径基于本目录（默认 ./data），也可用绝对路径（如 /srv/orca/data）。
ORCA_DATA_DIR=./data

# ---- 镜像（compose 直接引用，不在编排里编译；构建用 ./build.sh）----
# 可改为私有仓库完整地址（先用 ./build.sh --push 推送，再在服务器 docker login 后 docker compose up -d）：
#   ORCA_RELAY_IMAGE=swr.cn-east-3.myhuaweicloud.com/xryf/orca-relay:v1.4.237
#   ORCA_AUTH_IMAGE=swr.cn-east-3.myhuaweicloud.com/xryf/orca-auth:v1.4.237
ORCA_RELAY_IMAGE=orca-relay:latest
ORCA_AUTH_IMAGE=orca-auth:latest

# ---- 可选 ----
# 组织名（客户端账户显示用；默认 team / Team）
# ORCA_AUTH_ORG_ID=team
# ORCA_AUTH_ORG_NAME=Team
# 构建镜像时的 npm registry（国内服务器建议换成镜像源加速）
# NPM_REGISTRY=https://registry.npmmirror.com
