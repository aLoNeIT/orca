# Orca 自托管部署环境变量模板。
#
# 正式使用无需手工复制本文件：直接运行 ./init.sh（自动生成 .env 并填好随机密钥）。
# 本文件仅作字段说明；手工方式：cp .env.example .env 后按注释填写。

# ---- 必填 ----
# 公开域名（Caddy 自动申请 HTTPS 证书用；不含 https:// 前缀）
PUBLIC_HOSTNAME=relay.example.com
# 客户端访问的完整 origin：必须 https、不带路径/尾斜杠，且与上面的域名一致
# （桌面端会做 canonical origin 校验，且它逐字节用作 relay 的 token issuer）
ORCA_RELAY_PUBLIC_URL=https://relay.example.com
# relay 的 assignment 签名密钥（≥32 字节 hex）。生成：openssl rand -hex 32
# 也可留空：容器首次启动自动生成并持久化到数据卷（/data/auth/assignment-key）
ORCA_RELAY_ASSIGNMENT_SIGNING_KEY=

# ---- 可选 ----
# 组织名（客户端账户显示用；默认 team / Team）
# ORCA_AUTH_ORG_ID=team
# ORCA_AUTH_ORG_NAME=Team
# 构建镜像时的 npm registry（国内服务器建议换成镜像源加速）
# NPM_REGISTRY=https://registry.npmmirror.com
